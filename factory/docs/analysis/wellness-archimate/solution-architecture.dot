digraph G{
rankdir=TB; newrank=true; compound=true; splines=ortho;
graph[fontname="Helvetica",fontsize=11,labelloc=t,nodesep=0.4,ranksep=0.8,bgcolor="white"];
node[shape=box,style="rounded,filled",fontname="Helvetica",fontsize=9,margin="0.14,0.08"];
edge[arrowsize=0.7];
label="Wellness Platform - Solution Architecture (Graphviz, colors fixed)";
subgraph cluster_z_client{
  label="Client Surfaces — Sahatna Citizen App"; style=filled; color="#D79B00"; fillcolor="#FAFAFA"; penwidth=2; fontsize=10; fontcolor="#D79B00";
